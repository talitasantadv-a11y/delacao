# Copie este arquivo para .env e ajuste os valores.

# String de conexão do banco Postgres (ex: gerada pela Vercel Postgres/Neon,
# Supabase, Railway, ou qualquer Postgres). No painel da Vercel, geralmente
# aparece como POSTGRES_PRISMA_URL ou DATABASE_URL — use o valor com
# "pgbouncer=true" se houver mais de uma opção (conexão em pool).
DATABASE_URL="postgresql://usuario:senha@host:5432/banco"

# Chave usada pelo NextAuth para assinar sessões.
# Gere uma nova com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="troque-por-uma-chave-aleatoria"

# Opcional: necessário apenas em produção (Vercel), para upload de documentos.
# É preenchido automaticamente quando você conecta um "Blob Store" ao projeto
# na Vercel. Sem isso, o upload de documentos usa o disco local (funciona só
# em desenvolvimento).
BLOB_READ_WRITE_TOKEN=""
