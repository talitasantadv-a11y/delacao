# Copie este arquivo para .env e ajuste os valores.

# Banco de dados SQLite local (usado via driver adapter libSQL)
DATABASE_URL="file:./dev.db"

# Chave usada pelo NextAuth para assinar sessões.
# Gere uma nova com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="troque-por-uma-chave-aleatoria"
